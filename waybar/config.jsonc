{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-right": ["wireplumber", "backlight", "battery", "clock", "clock#date"],
    "spacing": 20,
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "10": "1",
            "11": "2",
            "12": "3",
            "13": "4",
            "14": "5",
            "15": "6",
            "16": "7",
            "17": "8",
            "18": "9",
        },
        "all-outputs": false,
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "  {capacity}%",
        "format": "{icon}   {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "   {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },
    "clock": {
        "timezone": "Europe/Stockholm",
        "format": "󰥔  {:%H:%M}"
    },
    "clock#date": {
        "timezone": "Europe/Stockholm",
        "format": "  {:%Y-%m-%d}"
    },
    "backlight": {
        "format": "  {percent}%"
    }
}
